# ===== 服务端口 =====
PORT=48085

# ===== 语音转文字联动（Hold 模式 + 前端「转文字」开关）=====
# 引擎：iflytek-api = 讯飞私有 ASR 直连（推荐）；win-dictation = Win+H 系统听写（保底）
# 凭据缺失时引擎自动回落 win-dictation
VOW_DICTATION_ENGINE=iflytek-api
# 讯飞私有 ASR 凭据（提取方式见 scripts/recon/FINDINGS.md）
# VOW_IFLYTEK_API_KEY=
# VOW_IFLYTEK_API_SECRET=
# VOW_IFLYTEK_APP_ID=100IME
